# eBay API Credentials
# Copy this file to .env and fill in your values

# --- Required ---
EBAY_APP_ID=your_app_id_here
EBAY_CERT_ID=your_cert_id_here
EBAY_DEV_ID=your_dev_id_here
EBAY_USER_TOKEN=your_user_token_here

# --- Optional ---
# Set to "sandbox" to use eBay sandbox environment (default: production)
EBAY_ENVIRONMENT=production

# How many hours before renewal qualifies as "renewing tomorrow"
# Default: 36 hours (catches anything expiring within the next ~1.5 days)
RENEWAL_WINDOW_HOURS=36

# Dry run mode: if true, listings are identified but NOT ended (default: false)
DRY_RUN=false

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
